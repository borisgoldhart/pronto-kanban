# ---- Pronto instance ----
PRONTO_BASE_URL=https://beta.extranet-system.com
# Environments offered in the login-screen picker: "Label|https://host,Label 2|https://host2".
PRONTO_ENVIRONMENTS=Beta|https://beta.extranet-system.com,Production (havaspronto.com)|https://havaspronto.com
PRONTO_ALLOW_CUSTOM_ENV=true

# MULTI-USER MODE (recommended): leave credentials empty. Users sign in on the
# login screen with their own Pronto account (PKCE broker, email+password, or token).
TOKEN_GENERATOR_URL=
# PRONTO_BROKER=off           # hide "Sign in with HavasPronto"

# SINGLE-USER FALLBACK (local dev only)
PRONTO_EMAIL=
PRONTO_PASSWORD=
PRONTO_BEARER_TOKEN=

# ---- Server ----
PORT=8791

# ---- Kanban ----
# 1 = serve the captured Beta fixtures with a demo identity (no sign-in). 0 = live Pronto per user.
KANBAN_FIXTURES=1
# 1 = a column drop changes the task status in Pronto (legacy update-property call).
# 0 = keep the new status as an override in this app's store (demo-safe, nothing on Beta changes).
KANBAN_WRITE_STATUS=0
# Most tasks fetched per board query (pages of 500).
KANBAN_MAX_TASKS=3000

# ---- Sessions, ranks, prefs: Redis (REQUIRED on Vercel) ----
# Vercel Marketplace: Upstash Redis injects these.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Key namespace: lets this app share the SOW Planner's Redis database safely.
KV_PREFIX=kanban:
# or a plain Redis (local dev, ElastiCache in the end state):
# REDIS_URL=redis://localhost:6379

# ---- Large dataset guardrails (BRD BR-10) ----
# Task Explorer is constrained to the user's office; above this many tasks a recency
# window applies, then a hard cap, with a notice in the UI. Defaults: 400 live, 60 in fixture mode.
KANBAN_SAFE_THRESHOLD=
KANBAN_RECENCY_DAYS=30

# ---- Live updates (BRD BR-15): any Pusher-protocol relay (optional; app runs single-user without it) ----
# Pusher Channels (prototype): the same app and keys as the SOW Planner.
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=ap4
# Pronto Reverb / Soketi (end state): add the host and the same protocol applies.
# PUSHER_HOST=ws.havaspronto.com
# PUSHER_PORT=443
# PUSHER_SCHEME=https
